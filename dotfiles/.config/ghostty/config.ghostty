command = /usr/bin/zsh
font-family = "MesloLGS NF"
font-size = 14

# game boy frosted glass, matched to the quickshell bar
background-opacity = 0.78
background-blur = true
background-opacity-cells = true
unfocused-split-opacity = 0.85

# palette synced from the current quickshell (mist) theme
config-file = ?theme
